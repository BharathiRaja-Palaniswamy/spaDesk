# Copy to .env and fill in.
# Used by the dashboard assistant (POST /api/report/chat).
ANTHROPIC_API_KEY=

SPADESK_MODEL=claude-opus-5-5

# Tracing with LangSmith (optional): records each assistant question so it can
# be inspected at smith.langchain.com. Leave LANGSMITH_TRACING out to keep it off.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=spadesk
# Eval runs (python -m evals.run) are traced to their own project, not the one above.
# LANGSMITH_EVAL_PROJECT=spadesk-evals
# The spa's time zone, used to tell the assistant the current time.
# SPADESK_TIMEZONE=America/Los_Angeles
# The business document the customer site reads.
# SPADESK_DATA=data/business_doc.md
# The bookings file the report dashboard reads.
# SPADESK_REPORT_DATA=data/spadesk_bookings.json
# RAG: the document is cut into chunks of this many tokens, each sharing this
# many tokens with the chunk before it.
# SPADESK_CHUNK_TOKENS=150
# SPADESK_CHUNK_OVERLAP=30
# RAG: the most tokens of the header written above each chunk for search only
# (its place in the document, e.g. "Core Services > Facials > Glow Express
# Facial"); 0 for no headers. Chunk size + header must fit the embedding model.
# SPADESK_HEADER_TOKENS=50
# RAG: which provider turns text into vectors. "fastembed" runs a small model
# (all-MiniLM-L6-v2) on this machine and needs no key.
# SPADESK_EMBEDDING_PROVIDER=fastembed
# RAG: which vector store keeps the chunks and their vectors. "pinecone" (the
# default) is hosted and needs a key; its index is created on first use.
# "memory" keeps them in the app's memory, for working offline.
# SPADESK_VECTOR_STORE=pinecone
# PINECONE_API_KEY=
# SPADESK_PINECONE_INDEX=spadesk
# RAG: how many chunks are given to the model for a question.
# SPADESK_RETRIEVAL_TOP_K=3
# RAG: the reranker that reorders the first search's candidates before the
# best SPADESK_RETRIEVAL_TOP_K are kept ("cross-encoder", runs on this
# machine), or "none" to keep the first search's order; and how many
# candidates it chooses from.
# SPADESK_RERANKER=cross-encoder
# SPADESK_RERANK_CANDIDATES=20
# Which pipeline answers both chats: "langchain" (spadesk/lc/: a chain for
# customers, a LangGraph graph for the owner's report tool; the default), or
# "handbuilt" (spadesk/rag/, kept as the reference: it calls Claude directly).
# Both build the same prompt.
# SPADESK_RAG_ENGINE=langchain
# The model gateway (spadesk/models/): which model does each job. A model is
# "provider:model"; providers are "anthropic" (Claude) and "nebius" (open
# models). Claude Opus is the default; the eval judge always stays on Claude.
# SPADESK_MODEL_PROVIDER=anthropic
# SPADESK_MODEL=claude-opus-5-5
# A second model to try when the first fails (or answers in the wrong shape):
# SPADESK_MODEL_FALLBACK=anthropic:claude-haiku-4-5-20251001
# Move one job to another model, e.g. SPADESK_PROFILE_CHEAP_ROUTER=nebius:<model>
# Nebius: its OpenAI-compatible address (check it in the Nebius console) and key.
# SPADESK_NEBIUS_BASE_URL=https://api.studio.nebius.com/v1/
# NEBIUS_API_KEY=
