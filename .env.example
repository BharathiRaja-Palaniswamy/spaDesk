# Copy to .env and fill in.
# Used by the dashboard assistant (POST /api/report/chat).
ANTHROPIC_API_KEY=

SPADESK_MODEL=claude-opus-5-5
# The spa's time zone, used to tell the assistant the current time.
# SPADESK_TIMEZONE=America/Los_Angeles
# The business document the customer site reads.
# SPADESK_DATA=data/business_doc.md
# The bookings file the report dashboard reads.
# SPADESK_REPORT_DATA=data/spadesk_bookings.json
