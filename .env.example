# Copy to .env and fill in.
# Claude's key, for the "claude" model set and the eval judge.
ANTHROPIC_API_KEY=

# Which models the app uses: "claude" or "opensource" (models hosted by
# Nebius). Each set has a high-end model (the chats, the booking agent) and a
# low-end one (quick jobs, like reading a name and number). See
# spadesk/models/profiles.py. The evals always use "opensource".
SPADESK_MODELS=claude

# Tracing with LangSmith (optional): records each assistant question so it can
# be inspected at smith.langchain.com. Leave LANGSMITH_TRACING out to keep it off.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=spadesk
# Eval runs (python -m evals.run) are traced to their own project, not the one above.
# LANGSMITH_EVAL_PROJECT=spadesk-evals
# The spa's time zone, used to tell the assistant the current time.
# SPADESK_TIMEZONE=America/Los_Angeles
# The business document the customer site reads.
# SPADESK_DATA=data/business_doc.md
# The bookings file the report dashboard reads.
# SPADESK_REPORT_DATA=data/spadesk_bookings.json
# RAG: the document is cut into chunks of this many tokens, each sharing this
# many tokens with the chunk before it.
# SPADESK_CHUNK_TOKENS=150
# SPADESK_CHUNK_OVERLAP=30
# RAG: the most tokens of the header written above each chunk for search only
# (its place in the document, e.g. "Core Services > Facials > Glow Express
# Facial"); 0 for no headers. Chunk size + header must fit the embedding model.
# SPADESK_HEADER_TOKENS=50
# RAG: which provider turns text into vectors. "pinecone" (the default) runs
# llama-text-embed-v2 on Pinecone's servers with PINECONE_API_KEY below;
# "minilm" runs a small model (all-MiniLM-L6-v2) on this machine, needs no
# key, and is downloaded once (python -m scripts.download_models).
# SPADESK_EMBEDDING_PROVIDER=pinecone
# RAG: which vector store keeps the chunks and their vectors. "pinecone" (the
# default) is hosted and needs a key; its index is created on first use.
# "memory" keeps them in the app's memory, for working offline.
# SPADESK_VECTOR_STORE=pinecone
# PINECONE_API_KEY=
# SPADESK_PINECONE_INDEX=spadesk
# RAG: how many chunks are given to the model for a question.
# SPADESK_RETRIEVAL_TOP_K=3
# RAG: the reranker that reorders the first search's candidates before the
# best SPADESK_RETRIEVAL_TOP_K are kept: "pinecone" (the default, on
# Pinecone's servers), "cross-encoder" (on this machine, downloaded once), or
# "none" to keep the first search's order; and how many candidates it
# chooses from.
# SPADESK_RERANKER=pinecone
# SPADESK_RERANK_CANDIDATES=20
# Booking: where bookings are kept: "memory" (in the app, lost on restart),
# or "google" (one Google calendar per therapist; see docs/google-calendar.md),
# and the grid appointments start on (every 30 minutes from opening).
# SPADESK_CALENDAR=memory
# SPADESK_SLOT_MINUTES=30
# The fewest minutes ahead a customer can book, change or cancel an appointment.
# SPADESK_MIN_NOTICE_MINUTES=30
# The owner's sign-in for the manage page (spadesk/access/). Without a
# password the manage page and the reports stay closed to everyone.
# SPADESK_OWNER_PASSWORD=
# Signs the sign-in cookie; without it, a random key is made at each start
# (which signs the owner out on every restart).
# SPADESK_SESSION_SECRET=
# The phone line (spadesk/voice/): the secret ElevenLabs sends as its API key
# when it calls POST /v1/chat/completions. Leave it out to keep the line off.
# SPADESK_VOICE_SECRET=
# The ElevenLabs agent the manage page's phone-line test (a voice widget)
# talks to: its agent id, not a secret. Leave it out to hide the widget.
# Customers never see it. The agent must allow public use, limited to the
# site's addresses in its Security > Allowlist.
# SPADESK_VOICE_AGENT_ID=
# Where the chat writes down customers it hands to the staff, with why.
# SPADESK_HANDOFFS=storage/handoffs.jsonl
# For "google": the service account's key file (its path, or its JSON text on
# a host); and, optionally, a Google account to share the calendars with, so
# someone can see the bookings in Google Calendar.
# GOOGLE_SERVICE_ACCOUNT=
# SPADESK_CALENDAR_OWNER=
# Which pipeline answers both chats: "langchain" (spadesk/lc/: a chain for
# customers, a LangGraph graph for the owner's report tool; the default), or
# "handbuilt" (spadesk/rag/, kept as the reference: it calls Claude directly).
# Both build the same prompt.
# SPADESK_RAG_ENGINE=langchain
# The model gateway (spadesk/models/): the models in each set. A model is
# "provider:model"; providers are "anthropic" (Claude) and "nebius" (open
# models). The eval judge always stays on Claude Opus.
# SPADESK_CLAUDE_HIGH=anthropic:claude-opus-5-5
# SPADESK_CLAUDE_LOW=anthropic:claude-haiku-4-5-20251001
# SPADESK_OPENSOURCE_HIGH=nebius:Qwen/Qwen3-235B-A22B-Instruct-2507
# SPADESK_OPENSOURCE_LOW=nebius:Qwen/Qwen3-30B-A3B-Instruct-2507
# A second model to try when the first fails (or answers in the wrong shape); off by default:
# SPADESK_MODEL_FALLBACK=
# Move one job to another model, e.g. SPADESK_PROFILE_CHEAP_ROUTER=nebius:<model>
# Nebius: its OpenAI-compatible address (check it in the Nebius console) and key.
# SPADESK_NEBIUS_BASE_URL=https://api.studio.nebius.com/v1/
# NEBIUS_API_KEY=
