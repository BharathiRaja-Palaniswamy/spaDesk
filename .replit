# How Replit runs spaDesk. Replit sets PORT for a deployment; the app must
# listen on 0.0.0.0 (every address), not only on this machine.
# Secrets (ANTHROPIC_API_KEY, PINECONE_API_KEY, LANGSMITH_*) go in Replit's Secrets panel, never here.

modules = ["python-3.12"]

# The Run button in the workspace: install what is missing, then start the server.
run = "pip install -q -r requirements.txt && python -m scripts.download_models && uvicorn spadesk.app:app --host 0.0.0.0 --port 8000"

[deployment]
deploymentTarget = "autoscale"
# Install, then download the two small local models, so the first question does not wait for them.
build = ["sh", "-c", "pip install -r requirements.txt && python -m scripts.download_models"]
run = ["sh", "-c", "uvicorn spadesk.app:app --host 0.0.0.0 --port ${PORT:-8000}"]

[[ports]]
localPort = 8000
externalPort = 80
